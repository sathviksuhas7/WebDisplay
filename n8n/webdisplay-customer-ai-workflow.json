      "name": "Validate Backend Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'You are WebDisplay Bank customer support assistant. Use only supplied customer context and general banking/portal knowledge. Never invent account details. Never request passwords, OTPs, PINs, CVV or full account credentials. Never reveal another customer information. Do not initiate transfers, change profile data, approve documents or perform financial actions. Direct those actions to the authenticated portal workflow. Customer context: ' + JSON.stringify($json.customerContext) + '\\nCustomer question: ' + $json.message }}",
        "options": {
          "systemMessage": "Be concise, professional and clear. If requested information is not in the supplied context, say you cannot access it here and direct the customer to the relevant portal section. Never claim to have performed an action."
        }
      },
      "id": "ai-agent",
      "name": "Customer Support AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { reply: $json.output || $json.text || 'I could not generate a response. Please try again.' } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond",
