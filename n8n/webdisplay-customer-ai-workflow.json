        "jsCode": "const item=$input.first().json; const body=item.body||item; if(typeof body.message!=='string'||!body.message.trim()||body.message.length>2000) throw new Error('Invalid message'); return [{json:{sessionId:body.sessionId,message:body.message,customerContext:body.customerContext||{}}}];"
      },
